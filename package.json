{
  "name": "telegram-fetcher",
  "version": "0.1.0",
  "description": "CLI tool to fetch latest messages from Telegram bots, channels, and groups",
  "type": "module",
  "bin": {
    "telegram-fetch": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "telegram",
    "bot",
    "cli",
    "fetch",
    "messages"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.2.0",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
